<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Plainspoken.App</RootNamespace>
    <AssemblyName>Plainspoken</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\..\assets\plainspoken.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <!-- CA1416: the whole project is Windows-only. -->
    <NoWarn>$(NoWarn);CA1416;CA1515;CA2007;CA1031;CA1303;CA5392;CA1848;CA1805</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Microphone capture (WASAPI). Pinned to the mature 2.x line; see docs/DECISIONS.md. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <!-- Offline fallback: whisper.cpp through Whisper.net (both MIT); the CPU runtime has the native libraries. -->
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Plainspoken.Core\Plainspoken.Core.csproj" />
  </ItemGroup>
  <!--
    Whisper.net looks for its native libraries in runtimes\win-x64 next to the exe, so they stay outside the single-file
    bundle; it brings them for every Windows CPU, and the x64 app needs only the x64 ones.
  -->
  <Target Name="PlaceWhisperLibraries" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="$([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Contains('win-arm64')) or $([System.String]::new('%(ResolvedFileToPublish.RelativePath)').Contains('win-x86'))" />
      <ResolvedFileToPublish Condition="$([System.String]::new('%(ResolvedFileToPublish.RelativePath)').StartsWith('runtimes'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\shared\vocabulary.default.txt" LogicalName="Plainspoken.vocabulary.default.txt" />
  </ItemGroup>
</Project>
