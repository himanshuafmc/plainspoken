<Project>
  <!--
    Single source of truth for the app version and shared compiler settings.
    To release: bump <VersionPrefix>, push, then tag v<VersionPrefix>.
  -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- Working name. User-visible strings come from Plainspoken.Core.AppInfo.Name. -->
    <Product>Plainspoken</Product>
    <Company>Plainspoken contributors</Company>
    <Copyright>Copyright (C) 2026 Plainspoken contributors. Licensed under GPL-3.0.</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <!-- Lets the Windows app build on the Linux cloud VM and CI (it still only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
